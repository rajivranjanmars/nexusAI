    {
      "name": "Auth",
      "item": [
        {
          "name": "Get App Token (PKI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Store access_token\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"access_token\");",
                  "  pm.environment.set(\"access_token\", json.access_token);",
                  "  if (json.refresh_token) pm.environment.set(\"refresh_token\", json.refresh_token);",
                  "  if (json.token_type) pm.environment.set(\"token_type\", json.token_type);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "https://finance.lpu.in"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signed_token\": \"<ES256-signed-JWT-from-app-private-key>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/app-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "app-token"
              ]
            },
            "description": "Exchange an app-signed ES256 JWT (signed with the app's private key registered via /api/apps/register) for proxy access + refresh tokens.\n\nThe `signed_token` is a JWT signed with your application's ES256 private key. The proxy verifies it against the stored public key.\n\nResponse includes `access_token`, `refresh_token`, `app_config`, and any resolved `data` from configured data_resolvers."
          },
          "response": []
        },
        {
          "name": "Get App User Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Store access_token from app-user token endpoint\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"access_token\");",
                  "  pm.environment.set(\"access_token\", json.access_token);",
                  "  if (json.refresh_token) pm.environment.set(\"refresh_token\", json.refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signed_token\": \"<short-lived-ES256-signed-JWT-from-app-backend>\",\n  \"force_workflow\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/app-user-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "app-user-token"
              ]
            },
            "description": "Browser-safe app-user token exchange. Your app backend mints a short-lived ES256 `signed_token` and the client exchanges it here.\n\nOptional `force_workflow` locks the issued token to a specific workflow (e.g. `lead_capture`). Must be in the app's `allowed_workflows`. All subsequent `/api/chat/message` calls with this token will use that workflow without needing to specify it per-message."
          },
          "response": []
        },
        {
          "name": "Get App User Token (Dev Convenience)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Store access_token from dev convenience endpoint\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"access_token\");",
                  "  pm.environment.set(\"access_token\", json.access_token);",
                  "  if (json.refresh_token) pm.environment.set(\"refresh_token\", json.refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"{{app_id}}\",\n  \"private_key\": \"{{app_private_key}}\",\n  \"actor_id\": \"STU123\",\n  \"actor_type\": \"student\",\n  \"origin\": \"https://finance.lpu.in\",\n  \"force_workflow\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/dev/app-user-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "dev",
                "app-user-token"
              ]
            },
            "description": "Development-only convenience endpoint. Provide `app_id`, the PEM `private_key`, and actor details; the proxy signs the short-lived app JWT internally and returns proxy access + refresh tokens.\n\nOptional `force_workflow` locks the issued token to a specific workflow (e.g. `lead_capture`). Must be in the app's `allowed_workflows`."
          },
          "response": []
        },
