            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Finance Portal\",\n  \"domain\": \"https://finance.lpu.in\",\n  \"allowed_workflows\": [\"general\"],\n  \"allowed_tools\": [\"detect_workflow\", \"get_student\", \"chat_complete\"]\n}",
