FROM python:3.11-slim-bookworm AS builder

WORKDIR /app
COPY mcp_server/requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Install backend_proxy dependencies (includes PDF/document processing)
COPY backend_proxy/requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# ─── Runtime Stage ────────────────────────────────────────────────
FROM python:3.11-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /root/.local /root/.local
COPY . .

ARG GIT_BRANCH=unknown
ARG GIT_COMMIT_SHA=unknown
ARG BUILD_TIMESTAMP=""

ENV GIT_BRANCH=${GIT_BRANCH} \
    GIT_COMMIT_SHA=${GIT_COMMIT_SHA} \
    BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

ENV PATH=/root/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN find /usr -type d \( -name '__pycache__' -o -name 'tests' \) -exec rm -rf {} + && \
    find /usr -type f \( -name '*.pyc' -o -name '*.pyo' \) -exec rm -f {} +

EXPOSE 8000
CMD ["python", "-m", "mcp_server.main"]
